# API-Zugangsdaten der Börse (niemals ins Git-Repo committen!)
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Sicherheitssperre für Live-Trading mit echtem Geld.
# Muss exakt auf YES gesetzt werden, zusätzlich zu mode.dry_run=false in config.yaml,
# damit der Bot echte Orders senden darf.
CONFIRM_LIVE_TRADING=
